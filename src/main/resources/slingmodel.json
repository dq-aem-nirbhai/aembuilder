{
  "classTemplate": {
    "package": "package {packageName};",
    "imports": "{imports}",
    "annotation": "{annotation}",
    "classDeclaration": "public class {className} {",
    "closingBrace": "}"
  },
  "methods": {
    "isEmpty": {
      "javadoc": "/**\n * Checks if all fields in this model are empty.\n * Used in HTL: ${!model.empty}\n */",
      "signature": "public boolean isEmpty() {",
      "bodyStart": "boolean empty = true;"
    }
  },
  "fieldChecks": {
    "multifield": "if ({name} != null && !{name}.isEmpty()) empty = false;",
    "checkbox": "if ({name}) empty = false;",
    "multiselect": "if ({name} != null && !{name}.isEmpty()) empty = false;",
    "tagfield": "if ({name} != null && !{name}.isEmpty()) empty = false;",
    "numberfield": "if ({name} != 0) empty = false;",
    "default": "if ({name} != null && !{name}.isEmpty()) empty = false;"
  },
  "getterTemplates": {
    "multifield": "public List<{type}> get{cap}() {\n        return {name};\n    }",
    "checkbox": "public boolean is{cap}() {\n        return {name};\n    }",
    "multiselect": "public List<String> get{cap}() {\n        return {name};\n    }",
    "tagfield": "public List<String> get{cap}() {\n        return {name};\n    }",
    "numberfield": "public double get{cap}() {\n        return {name};\n    }",
    "default": "public String get{cap}() {\n        return {name};\n    }"
  }
}
