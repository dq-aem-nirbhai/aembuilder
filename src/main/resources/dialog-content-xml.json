{
  "declarations": {
    "header": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<jcr:root xmlns:sling=\"http://sling.apache.org/jcr/sling/1.0\"\n          xmlns:cq=\"http://www.day.com/jcr/cq/1.0\"\n          xmlns:jcr=\"http://www.jcp.org/jcr/1.0\"\n          jcr:primaryType=\"nt:unstructured\"\n          jcr:title=\"${dialogTitle}\"\n          sling:resourceType=\"cq/gui/components/authoring/dialog\"${superTypeAttr}>",
    "footer": "</jcr:root>",
    "superTypeAttr": "\n sling:resourceSuperType=\"${superType}/cq:dialog\""
  },
  "layouts": {
    "flat": "<layout jcr:primaryType=\"nt:unstructured\" sling:resourceType=\"granite/ui/components/coral/foundation/layouts/fixedcolumns\"/>",
    "tabs": "<layout jcr:primaryType=\"nt:unstructured\" sling:resourceType=\"granite/ui/components/coral/foundation/layouts/tabs\"/>"
  },
  "containers": {
    "flatStart": "<content jcr:primaryType=\"nt:unstructured\" sling:resourceType=\"granite/ui/components/coral/foundation/container\">\n    ${layout}\n    <items jcr:primaryType=\"nt:unstructured\">\n        <column jcr:primaryType=\"nt:unstructured\" sling:resourceType=\"granite/ui/components/coral/foundation/container\">\n            <items jcr:primaryType=\"nt:unstructured\">",
    "flatEnd": "            </items>\n        </column>\n    </items>\n</content>",
    "tabsStart": "<content jcr:primaryType=\"nt:unstructured\" sling:resourceType=\"granite/ui/components/coral/foundation/container\">\n    ${layout}\n    <items jcr:primaryType=\"nt:unstructured\">\n        <tabs jcr:primaryType=\"nt:unstructured\" sling:resourceType=\"granite/ui/components/coral/foundation/tabs\">\n            <items jcr:primaryType=\"nt:unstructured\">",
    "tabsEnd": "            </items>\n        </tabs>\n    </items>\n</content>"
  },
  "tabTemplate": "<${tabNodeName}\n    jcr:primaryType=\"nt:unstructured\"\n    jcr:title=\"${tabTitle}\"\n    sling:resourceType=\"${resourceType}\">\n    <items jcr:primaryType=\"nt:unstructured\">\n        ${fields}\n    </items>\n</${tabNodeName}>",
  "autoMainTabTemplate": "<${tabNodeName}\n    jcr:primaryType=\"nt:unstructured\"\n    jcr:title=\"Main\"\n    sling:resourceType=\"${resourceType}\">\n    <items jcr:primaryType=\"nt:unstructured\">\n        ${fields}\n    </items>\n</${tabNodeName}>",
  "parentTabFallback": "<${tabNodeName}\n    jcr:primaryType=\"nt:unstructured\"\n    jcr:title=\"${tabTitle}\"\n    sling:resourceType=\"${resourceType}\">\n    <items jcr:primaryType=\"nt:unstructured\">\n        ${fields}\n    </items>\n</${tabNodeName}>",
  "parentTabTemplate": "<${tabNodeName}\n    jcr:primaryType=\"nt:unstructured\"\n    jcr:title=\"${tabTitle}\"\n    sling:resourceType=\"${resourceType}\">\n    <items jcr:primaryType=\"nt:unstructured\">\n        <!-- parent-tab-merge-point -->\n        ${fields}\n    </items>\n</${tabNodeName}>"
}