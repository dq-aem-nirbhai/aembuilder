<jcr:root
    jcr:primaryType="nt:unstructured"
    jcr:title="footer2 Dialog"
    sling:resourceType="cq/gui/components/authoring/dialog"
    xmlns:cq="http://www.day.com/jcr/cq/1.0"
    xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:sling="http://sling.apache.org/jcr/sling/1.0">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <layout
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/layouts/fixedcolumns"/>
        <items
            jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items
                    jcr:primaryType="nt:unstructured">
                    <maintitle
                        fieldLabel="Maintitle"
                        jcr:primaryType="nt:unstructured"
                        name="./maintitle"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"/>
                    <footerlinks
                        composite="true"
                        fieldLabel="Footerlinks"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield">
                        <field
                            jcr:primaryType="nt:unstructured"
                            name="./footerlinks"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                            <layout
                                jcr:primaryType="nt:unstructured"
                                margin="true"
                                sling:resourceType="granite/ui/components/coral/foundation/layouts/fixedcolumns"/>
                            <items
                                jcr:primaryType="nt:unstructured">
                                <footername
                                    fieldLabel="Footername"
                                    jcr:primaryType="nt:unstructured"
                                    name="./footername"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"/>
                                <footerlink
                                    fieldLabel="Footerlink"
                                    jcr:primaryType="nt:unstructured"
                                    name="./footerlink"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"/>
                            </items>
                        </field>
                    </footerlinks>
                    <socialmediaicons
                        composite="true"
                        fieldLabel="Socialmediaicons"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield">
                        <field
                            jcr:primaryType="nt:unstructured"
                            name="./socialmediaicons"
                            sling:resourceType="granite/ui/components/coral/foundation/form/fieldset">
                            <layout
                                jcr:primaryType="nt:unstructured"
                                margin="true"
                                sling:resourceType="granite/ui/components/coral/foundation/layouts/fixedcolumns"/>
                            <items
                                jcr:primaryType="nt:unstructured">
                                <icon
                                    autoStart="{Boolean}false"
                                    class="cq-droptarget"
                                    fieldLabel="Icon"
                                    fileNameParameter="./iconFileName"
                                    fileReferenceParameter="./icon"
                                    jcr:primaryType="nt:unstructured"
                                    mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                    multiple="{Boolean}false"
                                    name="./file"
                                    sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                    uploadUrl="/content/dam"/>
                                <iconlink
                                    fieldLabel="Iconlink"
                                    jcr:primaryType="nt:unstructured"
                                    name="./iconlink"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"/>
                            </items>
                        </field>
                    </socialmediaicons>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
